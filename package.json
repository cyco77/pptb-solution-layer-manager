    "finalize-package": "npm shrinkwrap",
    "release:version": "changeset version && npm run finalize-package"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
